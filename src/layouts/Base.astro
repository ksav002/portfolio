---
import '@fontsource-variable/onest/index.css';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {
  SITE_URL, profile, pageTitle, factSentence, ogImagePath, year, shownSocials,
} from '../lib/site.js';
import { profileGraph } from '../lib/seo.js';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: boolean;
}
const {
  title = pageTitle,
  description = factSentence,
  noindex = false,
  structuredData = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = `${SITE_URL}${ogImagePath}`;
const home = Astro.url.pathname === '/' ? '' : '/';
const sections = [
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
const socialIcon = { GitHub: 'brand-github', LinkedIn: 'brand-linkedin' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Apply a saved Creative choice before the first paint, so the wrong mode never flashes.
      try {
        if (localStorage.getItem('kp-mode') === 'creative') {
          document.documentElement.dataset.mode = 'creative';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0a1211');
        }
      } catch (e) {}
    </script>
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI tools" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, full-stack developer`} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Keshab" />
    <meta property="profile:last_name" content="Poudel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(profileGraph())} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="nav">
      <div class="page nav__bar">
        <a class="nav__name" href={`${home}#top`}>{profile.name}</a>
        <nav class="nav__links" aria-label="Sections">
          {sections.map((s) => <a href={`${home}#${s.id}`} data-section-link={s.id}>{s.label}</a>)}
        </nav>
        <a class="btn btn--primary btn--small" href={`mailto:${profile.email}`}>
          <Icon name="mail" />Email me
        </a>
      </div>
      <nav class="nav__tabs" aria-label="Sections" data-tabs>
        {sections.map((s) => <a href={`${home}#${s.id}`} data-section-link={s.id}>{s.label}</a>)}
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="page footer__bar">
        <p>© {year} {profile.name}</p>
        <div class="footer__links">
          {shownSocials.map((s) => (
            <a href={s.href} target="_blank" rel="me noopener" aria-label={s.label}><Icon name={socialIcon[s.label]} /></a>
          ))}
        </div>
      </div>
    </footer>

    <button class="mode-fab" type="button" aria-pressed="false" aria-label="Creative mode" title="Creative mode" data-mode-switch>
      <Icon name="moon" class="mode-fab__moon" />
      <Icon name="sun" class="mode-fab__sun" />
    </button>

    <script>
      import '../scripts/mode.js';
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import {
  profile, projects, timeline, skillGroups, shownSocials, extraSocials, whatsapp, headline, cvPath,
  parsePeriod,
} from '../lib/site.js';

const github = shownSocials.find((s) => s.label === 'GitHub');
const linkedin = shownSocials.find((s) => s.label === 'LinkedIn');
const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
const MONTH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const label = (iso) => {
  const [y, m] = iso.split('-');
  return m ? `${MONTH[Number(m) - 1]} ${y}` : y;
};
const withPeriod = (item) => ({ ...item, period: parsePeriod(item.period) });
const work = timeline.filter((item) => item.type === 'work').map(withPeriod)
  .map((item) => ({ ...item, badge: item.period.current ? 'Current' : 'Internship' }));
const education = timeline.filter((item) => item.type === 'education').map(withPeriod);
// The hero's screenshot picker works without JavaScript: one radio per
// project, and these rules show the screenshot and mark the tab it picks.
const pickerCss = ordered.map(({ slug }) => `
#shot-${slug}:checked ~ .stage__screens [data-shot="${slug}"] { display: block; }
#shot-${slug}:checked ~ .stage__picker label[for="shot-${slug}"] { background: var(--color-cool-soft); border-color: var(--color-cool); color: var(--color-ink); }
#shot-${slug}:focus-visible ~ .stage__picker label[for="shot-${slug}"] { outline: 2px solid var(--color-focus); outline-offset: 2px; }`).join('');
---
<Base structuredData>
  <style is:inline set:html={pickerCss}></style>
  <div id="top">
    <section class="hero container" aria-labelledby="name" data-intro>
      <div class="hero__copy">
        <div class="intro__photo">
          <Picture name="keshab-poudel" alt="Portrait of Keshab Poudel" sizes="5rem" eager />
        </div>
        <h1 id="name">{profile.name}</h1>
        <p class="hero__role">{profile.role.replace('Full stack', 'Full-stack')}</p>
        <p class="lead">{headline}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={`mailto:${profile.email}`}><Icon name="mail" />Email me</a>
          <a class="btn" href={cvPath} download><Icon name="download" />Download CV</a>
        </div>
        <ul class="hero__profiles" aria-label="Profiles">
          <li><a class="btn" href={github.href} target="_blank" rel="me noopener"><Icon name="brand-github" />GitHub</a></li>
          <li><a class="btn" href={linkedin.href} target="_blank" rel="me noopener"><Icon name="brand-linkedin" />LinkedIn</a></li>
        </ul>
      </div>

      <div class="stage">
        {ordered.map((project, i) => (
          <input class="visually-hidden" type="radio" name="shot" id={`shot-${project.slug}`} checked={i === 0} />
        ))}
        <div class="stage__screens">
          {ordered.map((project) => (
            <figure class="stage__shot" data-shot={project.slug}>
              <div class="stage__media">
                <Picture
                  name={project.slug}
                  alt={`Screenshot of the ${project.title.split(' —')[0]} project`}
                  sizes="(max-width: 60rem) 92vw, 44rem"
                  eager={project.slug === ordered[0].slug}
                />
              </div>
            </figure>
          ))}
        </div>
        <fieldset class="stage__picker">
          <legend class="visually-hidden">Show a project screenshot</legend>
          {ordered.map((project) => (
            <label for={`shot-${project.slug}`}>{project.title.split(' —')[0]}</label>
          ))}
        </fieldset>
      </div>

      <nav class="work" aria-labelledby="work-heading">
        <h2 id="work-heading" class="work__head">Selected projects</h2>
        <ol class="work__list">
          {ordered.map((project) => (
            <li>
              <a class="work__row" href={`#project-${project.slug}`}>
                <span class="work__title">{project.title.split(' —')[0]}</span>
                <span class="work__tags">{project.tags.join(', ')}</span>
                <Icon name="arrow-right" class="work__arrow" />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <section class="section container" id="projects" aria-labelledby="projects-heading">
      <div class="section__head">
        <h2 id="projects-heading">Projects</h2>
        <a class="link" href={github.href} target="_blank" rel="me noopener">All on GitHub</a>
      </div>
      <ol class="index">
        {ordered.map((project) => (
          <li class="index__row" id={`project-${project.slug}`} data-project={project.slug}>
            <div class="index__thumb">
              <Picture
                name={project.slug}
                alt=""
                sizes="(max-width: 60rem) 92vw, 14rem"
              />
            </div>
            <h3 id={`${project.slug}-title`}>{project.title}</h3>
            <p class="index__summary">{project.summary}</p>
            <p class="index__built"><span class="visually-hidden">Built with: </span>{project.tags.join(', ')}</p>
            <a class="btn btn--small" href={project.codeUrl} target="_blank" rel="noopener">
              <Icon name="brand-github" />View code
              <span class="visually-hidden">for {project.title.split(' —')[0]}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="record container">
    <section class="record__part" id="experience" aria-labelledby="experience-heading">
      <div class="section__head">
        <h2 id="experience-heading">Experience</h2>
      </div>
      <ol class="trail">
        {work.map((row) => (
          <li class="trail__row">
            <span class="trail__when">
              <time datetime={row.period.start}>{label(row.period.start)}</time>
              {' – '}
              {row.period.current ? 'now' : <time datetime={row.period.end}>{label(row.period.end)}</time>}
            </span>
            <div class="trail__body">
              <h3>{row.title}</h3>
              <p class="trail__org">{row.org}</p>
              <p>{row.description}</p>
            </div>
            <span class:list={['chip', { 'chip--now': row.period.current }]}>{row.badge}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="record__part" id="education" aria-labelledby="education-heading">
      <div class="section__head">
        <h2 id="education-heading">Education</h2>
      </div>
      <ol class="trail">
        {education.map((row) => (
          <li class="trail__row">
            <span class="trail__when">
              <time datetime={row.period.start}>{label(row.period.start)}</time>
              {' – '}
              <time datetime={row.period.end}>{label(row.period.end)}</time>
            </span>
            <div class="trail__body">
              <h3>{row.title}</h3>
              <p class="trail__org">{row.org}</p>
              <p>{row.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    </div>

    <section class="section container" id="skills" aria-labelledby="skills-heading">
      <div class="section__head">
        <h2 id="skills-heading">Skills</h2>
      </div>
      <div class="skills">
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.category}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="contact container" id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Let’s talk</h2>
      <p class="contact__line">Email is the fastest way to reach me. Also open to freelance projects.</p>
      <p class="contact__email">
        <a class="reading" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button class="copy-btn" type="button" data-copy={profile.email} hidden>
          <Icon name="copy" /><span data-copy-label>Copy</span>
        </button>
        <span class="visually-hidden" role="status" data-copy-status></span>
      </p>
      <div class="contact__actions">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}><Icon name="mail" />Email me</a>
        <a class="btn" href={whatsapp.href} target="_blank" rel="noopener" aria-label={`WhatsApp ${whatsapp.handle}`}><Icon name="brand-whatsapp" />WhatsApp</a>
        <a class="btn" href={cvPath} download><Icon name="download" />Download CV</a>
        <a class="btn" href={github.href} target="_blank" rel="me noopener"><Icon name="brand-github" />GitHub</a>
        <a class="btn" href={linkedin.href} target="_blank" rel="me noopener"><Icon name="brand-linkedin" />LinkedIn</a>
      </div>
      <ul class="contact__social" aria-label="Other profiles">
        {extraSocials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="me noopener" aria-label={s.label} title={s.label}>
              <Icon name={`brand-${s.label.toLowerCase()}`} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  import '../scripts/copy.js';
  import '../scripts/nav-highlight.js';
</script>
